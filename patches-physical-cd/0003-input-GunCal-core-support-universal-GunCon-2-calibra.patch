diff --git a/guncal.cpp b/guncal.cpp
new file mode 100644
index 0000000..45ef250
--- /dev/null
+++ b/guncal.cpp
@@ -0,0 +1,283 @@
+#include <string.h>
+#include <math.h>
+#include <stdlib.h>
+#include "guncal.h"
+
+guncal_target guncal_target_xy(int point, int margin_pct)
+{
+	int mx = GUNCAL_PX_W * margin_pct / 100;
+	int my = GUNCAL_PX_H * margin_pct / 100;
+	int l = mx, r = GUNCAL_PX_W - 1 - mx, t = my, b = GUNCAL_PX_H - 1 - my;
+	guncal_target g;
+
+	switch (point)
+	{
+	case 0:  g.x = GUNCAL_PX_W / 2; g.y = GUNCAL_PX_H / 2; break;   // centre
+	case 1:  g.x = l; g.y = t; break;                               // top left
+	case 2:  g.x = r; g.y = t; break;                               // top right
+	case 3:  g.x = r; g.y = b; break;                               // bottom right
+	default: g.x = l; g.y = b; break;                               // bottom left
+	}
+	return g;
+}
+
+// least squares: r = a * p + b
+static int fit_axis(const double *p, const double *r, int n, double *a, double *b)
+{
+	double sp = 0, sr = 0, spp = 0, spr = 0;
+	for (int i = 0; i < n; i++) { sp += p[i]; sr += r[i]; spp += p[i] * p[i]; spr += p[i] * r[i]; }
+	double den = n * spp - sp * sp;
+	if (fabs(den) < 1e-6) return 0;
+	*a = (n * spr - sp * sr) / den;
+	*b = (sr - *a * sp) / n;
+	return 1;
+}
+
+int guncal_fit_points(const int raw[][2], const guncal_target *t, int n, guncal_fit *out)
+{
+	memset(out, 0, sizeof(*out));
+	if (n < 3) return 0;
+	if (n > GUNCAL_NPOINTS) n = GUNCAL_NPOINTS;
+
+	double px[GUNCAL_NPOINTS], py[GUNCAL_NPOINTS], rx[GUNCAL_NPOINTS], ry[GUNCAL_NPOINTS];
+	for (int i = 0; i < n; i++) { px[i] = t[i].x; py[i] = t[i].y; rx[i] = raw[i][0]; ry[i] = raw[i][1]; }
+
+	if (!fit_axis(px, rx, n, &out->ax, &out->bx)) return 0;
+	if (!fit_axis(py, ry, n, &out->ay, &out->by)) return 0;
+
+	for (int i = 0; i < n; i++)
+	{
+		out->rx[i] = rx[i] - (out->ax * px[i] + out->bx);
+		out->ry[i] = ry[i] - (out->ay * py[i] + out->by);
+		if (fabs(out->rx[i]) > out->resid_x) out->resid_x = fabs(out->rx[i]);
+		if (fabs(out->ry[i]) > out->resid_y) out->resid_y = fabs(out->ry[i]);
+	}
+
+	// Sane means: raw grows with position at a plausible rate (about 1.2 raw units per pixel across, about 1 per line down)
+	// and the points sit on the line. Anything else is a missed or mis-aimed shot.
+	if (out->ax < 0.25 || out->ax > 4.0 || out->ay < 0.25 || out->ay > 4.0) return 0;
+	if (out->resid_x > 12.0 || out->resid_y > 10.0) return 0;
+	out->valid = 1;
+	return 1;
+}
+
+void guncal_raw_to_px(const guncal_fit *f, int rawx, int rawy, int *px, int *py)
+{
+	*px = (int)floor((rawx - f->bx) / f->ax + 0.5);
+	*py = (int)floor((rawy - f->by) / f->ay + 0.5);
+}
+
+void guncal_px_to_raw(const guncal_fit *f, double px, double py, double *rawx, double *rawy)
+{
+	*rawx = f->ax * px + f->bx;
+	*rawy = f->ay * py + f->by;
+}
+
+#define FILE_MAGIC 0x4C414347   // 'GCAL'
+
+void guncal_fit_to_file(const guncal_fit *f, int32_t out[GUNCAL_FILE_INTS])
+{
+	out[0] = FILE_MAGIC;
+	out[1] = (int32_t)lround(f->ax * 1000.0);
+	out[2] = (int32_t)lround(f->bx * 1000.0);
+	out[3] = (int32_t)lround(f->ay * 1000.0);
+	out[4] = (int32_t)lround(f->by * 1000.0);
+	out[5] = 1;
+}
+
+int guncal_fit_from_file(const int32_t in[GUNCAL_FILE_INTS], guncal_fit *f)
+{
+	memset(f, 0, sizeof(*f));
+	if (in[0] != FILE_MAGIC || in[5] != 1) return 0;
+	f->ax = in[1] / 1000.0; f->bx = in[2] / 1000.0;
+	f->ay = in[3] / 1000.0; f->by = in[4] / 1000.0;
+	if (f->ax < 0.25 || f->ax > 4.0 || f->ay < 0.25 || f->ay > 4.0) return 0;
+	f->valid = 1;
+	return 1;
+}
+
+int guncal_core_edges(const guncal_fit *f, const guncal_core_timing *t, int out[4])
+{
+	if (!f || !f->valid || !t || t->width < 2 || t->height < 2 || t->active_ns <= 0 || t->de_h_ns < 0) return 0;
+
+	double px_ns   = t->active_ns / t->width;                                       // time per picture pixel
+	double left_ns = t->hs_ns + t->de_h_ns;                                         // from HSync start to the first pixel
+	double p_left  = left_ns / 100.0 - GUNCAL_CAL_HS_TO_PIC_PX;                     // in GunCal pixels
+	double p_right = (left_ns + (t->width - 1) * px_ns) / 100.0 - GUNCAL_CAL_HS_TO_PIC_PX;
+
+	double y_top   = (t->vs_lines + t->de_v) - GUNCAL_CAL_VS_TO_PIC_LINES;          // in GunCal lines
+	double y_bot   = y_top + (t->height - 1);
+
+	out[0] = (int)floor(f->ay * y_top   + f->by + 0.5);
+	out[1] = (int)floor(f->ay * y_bot   + f->by + 0.5);
+	out[2] = (int)floor(f->ax * p_left  + f->bx + 0.5);
+	out[3] = (int)floor(f->ax * p_right + f->bx + 0.5);
+	return out[0] != out[1] && out[2] != out[3];
+}
+
+// ---------------------------------------------------------------- sequence
+
+static int median(int *v, int n)
+{
+	int t[GUNCAL_SAMPLES_MAX];
+	memcpy(t, v, n * sizeof(int));
+	for (int i = 1; i < n; i++)
+	{
+		int k = t[i], j = i - 1;
+		while (j >= 0 && t[j] > k) { t[j + 1] = t[j]; j--; }
+		t[j + 1] = k;
+	}
+	return t[n / 2];
+}
+
+void guncal_init(guncal_sm *s, const guncal_fit *stored, int margin_pct)
+{
+	memset(s, 0, sizeof(*s));
+	s->margin_pct = margin_pct;
+	if (stored && stored->valid)
+	{
+		s->fit = *stored;
+		s->state = GCS_MONITOR;
+	}
+	else
+	{
+		s->state = GCS_AIM;
+		s->point = 0;
+	}
+}
+
+void guncal_nudge(guncal_sm *s, int delta_pct)
+{
+	if (s->state != GCS_AIM) return;
+	int m = s->margin_pct + delta_pct;
+	if (m < 6) m = 6;
+	if (m > 30) m = 30;
+	s->margin_pct = m;
+}
+
+void guncal_accept(guncal_sm *s)
+{
+	if (s->state == GCS_VERIFY)
+	{
+		s->state = GCS_MONITOR;
+		s->msg = GUNCAL_MSG_NONE;
+	}
+}
+
+void guncal_report(guncal_sm *s, int x, int y, int trig, uint32_t now_ms)
+{
+	s->rawx = x;
+	s->rawy = y;
+
+	if (trig && !s->trig)
+	{
+		s->t_trig = now_ms;
+		s->hold_fired = 0;
+		if (s->state == GCS_AIM)
+		{
+			s->state = GCS_COLLECT;
+			s->t_press = now_ms;
+			s->n = 0;
+			s->first_valid_dt = 0;
+			s->msg = GUNCAL_MSG_NONE;
+			s->flash_seq = (s->flash_seq + 1) & 3;
+		}
+	}
+	s->trig = trig;
+
+	if (s->state == GCS_COLLECT && x >= GUNCAL_VALID_X && (uint32_t)(now_ms - s->t_press) <= GUNCAL_COLLECT_MS && s->n < GUNCAL_SAMPLES_MAX)
+	{
+		if (!s->first_valid_dt) s->first_valid_dt = (now_ms - s->t_press) ? (now_ms - s->t_press) : 1;
+		s->xs[s->n] = x;
+		s->ys[s->n] = y;
+		s->n++;
+	}
+}
+
+void guncal_tick(guncal_sm *s, uint32_t now_ms)
+{
+	if (s->state == GCS_COLLECT && (uint32_t)(now_ms - s->t_press) >= GUNCAL_COLLECT_MS)
+	{
+		s->shot_done = 1;
+		s->shot_point = s->point;
+		s->shot_n = s->n;
+
+		if (s->n >= GUNCAL_MIN_SAMPLES)
+		{
+			s->shot_ok = 1;
+			s->raw[s->point][0] = median(s->xs, s->n);
+			s->raw[s->point][1] = median(s->ys, s->n);
+			s->tpos[s->point] = guncal_target_xy(s->point, s->margin_pct);
+			s->first_dt[s->point] = (int)s->first_valid_dt;
+			s->point++;
+			s->msg = GUNCAL_MSG_NONE;
+			s->state = GCS_AIM;
+
+			if (s->point >= GUNCAL_NPOINTS)
+			{
+				guncal_fit f;
+				if (guncal_fit_points(s->raw, s->tpos, GUNCAL_NPOINTS, &f))
+				{
+					s->fit = f;
+					s->saved = 1;
+					s->state = GCS_VERIFY;
+					s->msg = GUNCAL_MSG_SAVED;
+				}
+				else
+				{
+					s->fit = f;                  // keep the numbers for the log; valid is 0
+					s->msg = GUNCAL_MSG_BAD;     // inconsistent shots: start over
+				}
+				s->point = 0;
+			}
+		}
+		else
+		{
+			s->shot_ok = 0;
+			s->msg = GUNCAL_MSG_MISSED;       // the gun saw no light during the flash: same target again
+			s->state = GCS_AIM;
+		}
+	}
+
+	if (s->trig && !s->hold_fired && (uint32_t)(now_ms - s->t_trig) >= GUNCAL_HOLD_MS && s->state != GCS_COLLECT)
+	{
+		s->hold_fired = 1;
+		s->state = GCS_AIM;
+		s->point = 0;
+		s->msg = GUNCAL_MSG_NONE;
+	}
+}
+
+uint32_t guncal_cmd_word(const guncal_sm *s)
+{
+	uint32_t page = (s->state == GCS_MONITOR) ? GUNCAL_PAGE_MONITOR : (s->state == GCS_VERIFY) ? GUNCAL_PAGE_VERIFY : GUNCAL_PAGE_CAL;
+	uint32_t w = page | ((uint32_t)(s->point & 15) << 2) | ((uint32_t)(s->flash_seq & 3) << 6) | ((uint32_t)(s->msg & 3) << 8);
+
+	if ((s->state == GCS_MONITOR || s->state == GCS_VERIFY) && s->fit.valid && s->rawx >= GUNCAL_VALID_X)
+	{
+		int px, py;
+		guncal_raw_to_px(&s->fit, s->rawx, s->rawy, &px, &py);
+		if (px >= -20 && px < GUNCAL_PX_W + 20 && py >= -20 && py < GUNCAL_PX_H + 20)
+		{
+			if (px < 0) px = 0;
+			if (px > GUNCAL_PX_W - 1) px = GUNCAL_PX_W - 1;
+			if (py < 0) py = 0;
+			if (py > GUNCAL_PX_H - 1) py = GUNCAL_PX_H - 1;
+			w |= (1u << 10) | ((uint32_t)px << 11) | ((uint32_t)py << 21);
+		}
+	}
+	return w;
+}
+
+uint32_t guncal_target_word(const guncal_sm *s)
+{
+	guncal_target t = guncal_target_xy(s->point, s->margin_pct);
+	// during the check page the ring sits in the middle of the picture
+	if (s->state == GCS_VERIFY) t = guncal_target_xy(0, s->margin_pct);
+	return (uint32_t)t.x | ((uint32_t)t.y << 10) | ((uint32_t)GUNCAL_NPOINTS << 18);
+}
+
+uint32_t guncal_raw_word(int x, int y, int trig)
+{
+	return ((uint32_t)x & 0xFFF) | (((uint32_t)y & 0xFFF) << 12) | ((uint32_t)(trig ? 1 : 0) << 24);
+}
diff --git a/guncal.h b/guncal.h
new file mode 100644
index 0000000..807312f
--- /dev/null
+++ b/guncal.h
@@ -0,0 +1,129 @@
+#ifndef GUNCAL_H
+#define GUNCAL_H
+
+#include <stdint.h>
+
+// Universal GunCon 2 calibration, driven by the GunCal FPGA core (cores/GunCal in the project repo).
+//
+// The gun reports X as time since the line's sync pulse and Y as a line count since the frame's sync, so raw
+// X and Y are linear in the beam's position on the screen. The GunCal core draws targets at fixed positions in
+// its own pixel grid (x 0..528 at 10 MHz, y 0..239); the user shoots them in turn, the first valid reports during
+// the core's flash are the measurement, and a least-squares line per axis maps core pixels to raw gun units:
+//     raw_x = ax * px + bx        raw_y = ay * py + by
+// Five targets (centre and the four corners) give a long baseline both ways, so the aiming noise of a hand-held
+// gun averages out. After the fit the core shows a check page with a live crosshair; A or B ends it.
+// This module holds that maths and the sequencing. It has no MiSTer dependencies so it can be tested on the host.
+
+#define GUNCAL_NPOINTS      5
+#define GUNCAL_SAMPLES_MAX  64
+#define GUNCAL_COLLECT_MS   300     // valid reports in this window after a trigger pull are the measurement
+#define GUNCAL_MIN_SAMPLES  2
+#define GUNCAL_HOLD_MS      3000    // holding the trigger this long restarts (or, from the monitor page, starts) calibration
+#define GUNCAL_VALID_X      16      // raw X below this means the gun saw no light
+
+// pages and messages understood by the GunCal core
+enum { GUNCAL_PAGE_MONITOR = 0, GUNCAL_PAGE_CAL = 1, GUNCAL_PAGE_VERIFY = 2 };
+enum { GUNCAL_MSG_NONE = 0, GUNCAL_MSG_MISSED = 1, GUNCAL_MSG_SAVED = 2, GUNCAL_MSG_BAD = 3 };
+
+// The GunCal core's picture is GUNCAL_PX_W x GUNCAL_PX_H pixels (10 MHz pixel clock, 15.7 kHz). A CRT does not show all of it:
+// overscan and the bezel hide some on every set, so targets sit well inside, GUNCAL_MARGIN_DEF percent from the edges
+// (adjustable). The fit only ever uses where the user really shot, so hidden edges never matter: they are reached by
+// extrapolation along the line.
+#define GUNCAL_PX_W         529
+#define GUNCAL_PX_H         240
+#define GUNCAL_MARGIN_DEF   12
+
+struct guncal_target { int x, y; };                          // core pixel coordinates
+// Target order: centre, top-left, top-right, bottom-right, bottom-left.
+guncal_target guncal_target_xy(int point, int margin_pct);
+
+struct guncal_fit
+{
+	double ax, bx, ay, by;      // raw = a * p + b
+	double resid_x, resid_y;    // worst absolute residual over the points, raw units
+	double rx[GUNCAL_NPOINTS], ry[GUNCAL_NPOINTS];   // residual of each point
+	int    valid;
+};
+
+// Least-squares fit of n measured points. Returns 1 and fills *out (with valid set) if the result is sane.
+int  guncal_fit_points(const int raw[][2], const guncal_target *t, int n, guncal_fit *out);
+void guncal_raw_to_px(const guncal_fit *f, int rawx, int rawy, int *px, int *py);
+void guncal_px_to_raw(const guncal_fit *f, double px, double py, double *rawx, double *rawy);
+
+// Calibration file (little-endian int32s; values in thousandths).
+#define GUNCAL_FILE_INTS 6
+void guncal_fit_to_file(const guncal_fit *f, int32_t out[GUNCAL_FILE_INTS]);
+int  guncal_fit_from_file(const int32_t in[GUNCAL_FILE_INTS], guncal_fit *f);
+
+// ---- mapping the calibration onto a core ----
+//
+// The calibration is made in the GunCal core's own pixel grid. Any other core's picture sits somewhere else inside the
+// line and the frame, but MiSTer measures where (video_calc in hps_io.sv: the picture's width and duration, the time
+// from the end of HSync to the first picture pixel, the lines from the end of VSync to the first picture line). From that
+// the gun's raw value at the core's left/right/top/bottom picture edges follows: the same four numbers the old per-core
+// calibration stored (the core scales its analog gun axes across its picture).
+//
+// The sync pulse widths are not measured by the framework, so they are supplied (a per-core table, with defaults).
+struct guncal_core_timing
+{
+	double hs_ns;               // width of the core's HSync pulse
+	int    vs_lines;            // width of the core's VSync in lines
+	double de_h_ns;             // end of HSync to the first picture pixel (measured)
+	int    de_v;                // end of VSync to the first picture line, in lines (measured)
+	double active_ns;           // duration of the picture part of a line (measured)
+	int    width, height;       // picture pixels per line, lines per frame (measured)
+};
+
+// Where the GunCal core puts things relative to its sync pulses: the picture starts 94 pixels (of 100 ns) after HSync
+// starts and 17 lines after VSync starts (NTSC timing, 262 lines).
+#define GUNCAL_CAL_HS_TO_PIC_PX     94
+#define GUNCAL_CAL_VS_TO_PIC_LINES  17
+
+// out = { y_top, y_bottom, x_left, x_right }: the raw gun values at the picture's edges (the order of guncal[] in MiSTer).
+// Returns 0 if the timing or the fit is unusable.
+int guncal_core_edges(const guncal_fit *f, const guncal_core_timing *t, int out[4]);
+
+// ---- the sequence ----
+
+enum { GCS_MONITOR = 0, GCS_AIM, GCS_COLLECT, GCS_VERIFY };
+
+struct guncal_sm
+{
+	int      state;
+	int      point;                              // target being aimed at
+	uint32_t t_press;                            // trigger pull that opened the collection window
+	int      n;                                  // samples collected
+	int      xs[GUNCAL_SAMPLES_MAX], ys[GUNCAL_SAMPLES_MAX];
+	int      raw[GUNCAL_NPOINTS][2];
+	guncal_target tpos[GUNCAL_NPOINTS];          // where each point's target really was when it was shot (the margin can change)
+	int      first_dt[GUNCAL_NPOINTS];           // ms from the pull to the first valid report, per point
+	int      rawx, rawy;                         // latest report
+	int      trig;
+	uint32_t t_trig;                             // when the trigger went down
+	int      hold_fired;
+	int      flash_seq;
+	int      margin_pct;                         // target inset, percent of the picture
+	int      msg;
+	uint32_t first_valid_dt;                     // ms from the pull to the first valid report (0 = none yet)
+	guncal_fit fit;
+	int      saved;                              // a new fit is ready for the caller to store
+	int      shot_done;                          // a shot just finished: shot_point/shot_n/shot_ok describe it (caller clears)
+	int      shot_point, shot_n, shot_ok;
+};
+
+void guncal_init(guncal_sm *s, const guncal_fit *stored, int margin_pct);   // stored may be NULL
+void guncal_nudge(guncal_sm *s, int delta_pct);                                // move the targets in or out (gun D-pad)
