+// ---- GunCal core support (cores/GunCal in the project repo; sequence and maths in guncal.cpp) ----
+// Active only while the GunCal core is running. The core draws; this drives it through joystick_3/4/5.
+
+static guncal_sm gcal;
+static bool      gcal_on = false;
+static int       gcal_dev = -1;
+static uint32_t  gcal_sent[3] = {};
+static uint32_t  gcal_refresh = 0;
+static int       gcal_x = 0, gcal_y = 0, gcal_trig = 0;
+
+static uint32_t guncal_now_ms()
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_REALTIME, &ts);
+	return (uint32_t)ts.tv_sec * 1000u + (uint32_t)(ts.tv_nsec / 1000000);
+}
+
+static void guncal_file_name(int dev, char *name, size_t n)
+{
+	snprintf(name, n, "GUNCAL_uni_%04x_%04x_v1.cfg", input[dev].vid, input[dev].pid);
+}
+
+static void guncal_send(bool force)
+{
+	uint32_t w[3] = { guncal_target_word(&gcal), guncal_cmd_word(&gcal), guncal_raw_word(gcal_x, gcal_y, gcal_trig) };
+	for (int k = 0; k < 3; k++)
+	{
+		if (force || w[k] != gcal_sent[k])
+		{
+			user_io_joystick_word(3 + k, w[k]);
+			gcal_sent[k] = w[k];
+		}
+	}
+}
+
+// ev is one raw event of the GunCon 2, or NULL for the regular call from input_poll().
+static void guncal_service(const struct input_event *ev)
+{
+	if (strcmp(user_io_get_core_name(), "GUNCAL"))
+	{
+		gcal_on = false;
+		return;
+	}
+
+	uint32_t now = guncal_now_ms();
+
+	if (!gcal_on)
+	{
+		int d = -1;
+		for (int i = 0; i < NUMDEV; i++) if (input[i].quirk == QUIRK_LIGHTGUN_CRT) d = i;
+		if (d < 0) return;                          // no GunCon 2 (yet)
+
+		gcal_dev = d;
+		char name[64];
+		int32_t v[GUNCAL_FILE_INTS] = {};
+		guncal_fit f;
+		memset(&f, 0, sizeof(f));
+		guncal_file_name(d, name, sizeof(name));
+		int have = FileLoadConfig(name, v, sizeof(v)) && guncal_fit_from_file(v, &f);
+		guncal_init(&gcal, have ? &f : NULL, cfg.guncal_margin);
+		gcal_x = gcal_y = gcal_trig = 0;
+		gcal_on = true;
+		printf("GunCal: %s\n", have ? "loaded the saved calibration" : "no saved calibration, starting the sequence");
+		guncal_send(true);
+		gcal_refresh = now + 500;
+	}
+
+	if (ev)
+	{
+		if (ev->type == EV_ABS && ev->code == ABS_X) gcal_x = ev->value;
+		else if (ev->type == EV_ABS && ev->code == ABS_Y) gcal_y = ev->value;
+		else if (ev->type == EV_KEY && ev->code == GUNCON2_TRIGGER_CODE) gcal_trig = ev->value ? 1 : 0;
+		else if (ev->type == EV_ABS && ev->code == ABS_HAT0Y && ev->value) guncal_nudge(&gcal, ev->value < 0 ? 2 : -2);   // D-pad up: targets in, down: out
+		else if (ev->type == EV_KEY && (ev->code == 0x130 || ev->code == 0x131) && ev->value == 1) guncal_accept(&gcal);  // A or B: end the check page
+		else return;
+
+		now = (uint32_t)ev->time.tv_sec * 1000u + (uint32_t)ev->time.tv_usec / 1000u;
+		guncal_report(&gcal, gcal_x, gcal_y, gcal_trig, now);
+	}
+
+	guncal_tick(&gcal, ev ? guncal_now_ms() : now);
+
+	// Everything the calibration measures goes to a log in /config (appended), so it can be analysed afterwards.
+	char logpath[300];
+	snprintf(logpath, sizeof(logpath), "%s/config/GUNCAL_log.txt", getRootDir());
+
+	if (gcal.shot_done)
+	{
+		gcal.shot_done = 0;
+		printf("GunCal: shot at target %d: %d valid reports, first %d ms after the pull, %s\n",
+			gcal.shot_point, gcal.shot_n, gcal.shot_ok ? gcal.first_dt[gcal.shot_point] : 0, gcal.shot_ok ? "ok" : "missed");
+	}
+
+	bool bad = (gcal.msg == GUNCAL_MSG_BAD && gcal.state == GCS_AIM && gcal.point == 0 && gcal.raw[GUNCAL_NPOINTS - 1][0]);
+	static bool bad_logged = false;
+	if (gcal.saved || (bad && !bad_logged))
+	{
+		FILE *lf = fopen(logpath, "a");
+		if (lf)
+		{
+			fprintf(lf, "# GunCal %s margin %d%%: raw_x = %.4f*px + %.2f, raw_y = %.4f*py + %.2f, worst residual %.1f / %.1f\n",
+				gcal.saved ? "calibration" : "REJECTED calibration", gcal.margin_pct, gcal.fit.ax, gcal.fit.bx, gcal.fit.ay, gcal.fit.by, gcal.fit.resid_x, gcal.fit.resid_y);
+			for (int i = 0; i < GUNCAL_NPOINTS; i++)
+				fprintf(lf, "point %d: target px (%d,%d) raw (%d,%d) residual (%.1f,%.1f) first valid %d ms\n", i,
+					gcal.tpos[i].x, gcal.tpos[i].y, gcal.raw[i][0], gcal.raw[i][1], gcal.fit.rx[i], gcal.fit.ry[i], gcal.first_dt[i]);
+			fclose(lf);
+		}
+		bad_logged = !gcal.saved;
+	}
+	if (gcal.state == GCS_AIM && gcal.point > 0) bad_logged = false;
+
+	if (gcal.saved)
+	{
+		gcal.saved = 0;
+		char name[64];
+		int32_t v[GUNCAL_FILE_INTS];
+		guncal_file_name(gcal_dev, name, sizeof(name));
+		guncal_fit_to_file(&gcal.fit, v);
+		FileSaveConfig(name, v, sizeof(v));
+		printf("GunCal: calibration saved to %s: raw_x = %.4f * px + %.1f, raw_y = %.4f * py + %.1f (worst residual %.1f / %.1f)\n",
+			name, gcal.fit.ax, gcal.fit.bx, gcal.fit.ay, gcal.fit.by, gcal.fit.resid_x, gcal.fit.resid_y);
+	}
+
+	bool refresh = (int32_t)(now - gcal_refresh) >= 0;
+	if (refresh) gcal_refresh = now + 500;
+	guncal_send(refresh);
+}
