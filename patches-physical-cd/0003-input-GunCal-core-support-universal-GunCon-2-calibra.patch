+// plays the user: shoot the current target with a gun that obeys raw = a*px + b
+static void shoot(guncal_sm *s, uint32_t *t, int with_light)
+{
+	guncal_target tg = guncal_target_xy(s->point, s->margin_pct);
+	int x = with_light ? rawx_of(tg.x) : 0, y = with_light ? rawy_of(tg.y) : 5;
+	guncal_report(s, x, y, 0, *t); *t += 20;
+	guncal_report(s, x, y, 1, *t); *t += 20;           // pull
+	for (int i = 0; i < 6; i++) { guncal_report(s, x + (i & 1), y, 1, *t); *t += 20; }
+	guncal_report(s, x, y, 0, *t); *t += 20;           // release
+	*t += 400;                                         // past the collection window
+	guncal_tick(s, *t);
+}
+
+static void test_full_sequence()
+{
+	guncal_sm s;
+	guncal_init(&s, NULL, 12);
+	CHECK(s.state == GCS_AIM && s.point == 0);
+	CHECK((guncal_cmd_word(&s) & 3) == GUNCAL_PAGE_CAL);
+	CHECK(((guncal_target_word(&s) >> 18) & 15) == GUNCAL_NPOINTS);
+	uint32_t t = 1000;
+	for (int k = 0; k < GUNCAL_NPOINTS - 1; k++) { shoot(&s, &t, 1); CHECK(s.point == k + 1 && s.state == GCS_AIM); }
+	shoot(&s, &t, 1);
+	CHECK(s.state == GCS_VERIFY && s.fit.valid && s.saved);
+	CHECK((guncal_cmd_word(&s) & 3) == GUNCAL_PAGE_VERIFY);
+	CHECK(((guncal_cmd_word(&s) >> 8) & 3) == GUNCAL_MSG_SAVED);
+	CHECK(fabs(s.fit.ax - AX) < 0.02 && fabs(s.fit.ay - AY) < 0.02);
+	guncal_target ctr = guncal_target_xy(0, 12);
+	CHECK((guncal_target_word(&s) & 0x3FF) == (uint32_t)ctr.x);         // the check page ring is at the centre
+
+	// check page: the pointer is where the gun is
+	guncal_target tg = { 300, 120 };
+	guncal_report(&s, rawx_of(tg.x), rawy_of(tg.y), 0, t);
+	uint32_t w = guncal_cmd_word(&s);
+	CHECK((w >> 10) & 1);
+	CHECK(abs((int)((w >> 11) & 0x3FF) - tg.x) <= 2 && abs((int)((w >> 21) & 0xFF) - tg.y) <= 2);
+	guncal_report(&s, 0, 5, 0, t + 20);                // no light: no pointer
+	CHECK(!((guncal_cmd_word(&s) >> 10) & 1));
+
+	guncal_accept(&s);                                 // A or B
+	CHECK(s.state == GCS_MONITOR && (guncal_cmd_word(&s) & 3) == GUNCAL_PAGE_MONITOR);
+}
+
+static void test_missed_shot_repeats_the_point()
+{
+	guncal_sm s;
+	guncal_init(&s, NULL, 12);
+	uint32_t t = 1000;
+	shoot(&s, &t, 0);
+	CHECK(s.point == 0 && s.state == GCS_AIM && s.msg == GUNCAL_MSG_MISSED && s.shot_done && !s.shot_ok);
+	shoot(&s, &t, 1);
+	CHECK(s.point == 1 && s.msg == GUNCAL_MSG_NONE && s.shot_ok);
+}
+
+static void test_hold_trigger_restarts()
+{
+	guncal_fit f;
+	memset(&f, 0, sizeof(f));
+	f.ax = AX; f.bx = BX; f.ay = AY; f.by = BY; f.valid = 1;
+	guncal_sm s;
+	guncal_init(&s, &f, 12);
+	CHECK(s.state == GCS_MONITOR);
+	guncal_report(&s, 400, 100, 1, 1000);
+	guncal_tick(&s, 1000 + GUNCAL_HOLD_MS - 1);
+	CHECK(s.state == GCS_MONITOR);
+	guncal_tick(&s, 1000 + GUNCAL_HOLD_MS);
+	CHECK(s.state == GCS_AIM && s.point == 0);
+
+	// from the check page too, and shooting there (testing the aim) must not restart it
+	guncal_sm v;
+	guncal_init(&v, NULL, 12);
+	uint32_t t = 1000;
+	for (int k = 0; k < GUNCAL_NPOINTS; k++) shoot(&v, &t, 1);
+	CHECK(v.state == GCS_VERIFY);
+	guncal_report(&v, 400, 100, 1, t);
+	guncal_report(&v, 400, 100, 0, t + 100);
+	guncal_tick(&v, t + 200);
+	CHECK(v.state == GCS_VERIFY);
+	guncal_report(&v, 400, 100, 1, t + 1000);
+	guncal_tick(&v, t + 1000 + GUNCAL_HOLD_MS);
+	CHECK(v.state == GCS_AIM && v.point == 0);
+}
+
+static void test_margin_change_midway_still_fits()
+{
+	guncal_sm s;
+	guncal_init(&s, NULL, 12);
+	uint32_t t = 1000;
+	shoot(&s, &t, 1);
+	guncal_nudge(&s, 6);                               // targets move inward because the TV hides the corners
+	CHECK(s.margin_pct == 18);
+	shoot(&s, &t, 1);
+	guncal_nudge(&s, -4);
+	shoot(&s, &t, 1);
+	shoot(&s, &t, 1);
+	shoot(&s, &t, 1);
+	CHECK(s.state == GCS_VERIFY && s.fit.valid);
+	CHECK(fabs(s.fit.ax - AX) < 0.02 && fabs(s.fit.ay - AY) < 0.02);
+	guncal_sm n;
+	guncal_init(&n, NULL, 12);
+	guncal_nudge(&n, -100);
+	CHECK(n.margin_pct == 6);
+	guncal_nudge(&n, 100);
+	CHECK(n.margin_pct == 30);
+}
+
+static void test_noise_samples_use_median()
+{
+	guncal_sm s;
+	guncal_init(&s, NULL, 12);
+	guncal_target tg = guncal_target_xy(0, 12);
+	int x = rawx_of(tg.x), y = rawy_of(tg.y);
+	guncal_report(&s, x, y, 1, 1000);
+	guncal_report(&s, 900, 10, 1, 1020);               // one wild reading
+	guncal_report(&s, x + 1, y, 1, 1040);
+	guncal_report(&s, x, y + 1, 1, 1060);
+	guncal_report(&s, x - 1, y, 1, 1080);
+	guncal_tick(&s, 1000 + GUNCAL_COLLECT_MS);
+	CHECK(s.point == 1 && abs(s.raw[0][0] - x) <= 1 && abs(s.raw[0][1] - y) <= 1);
+}
+
+static guncal_fit make_fit()
+{
+	guncal_fit f;
+	memset(&f, 0, sizeof(f));
+	f.ax = AX; f.bx = BX; f.ay = AY; f.by = BY; f.valid = 1;
+	return f;
+}
+
+// the GunCal core describing itself must come out as its own pixel grid: x 0..528, y 0..239
+static void test_edges_for_the_calibration_core_itself()
+{
+	guncal_fit f = make_fit();
+	guncal_core_timing t;
+	t.hs_ns = 4600; t.vs_lines = 3;                 // GunCal: HSync 46 px, VSync 3 lines
+	t.de_h_ns = (638 - 590) * 100.0;                // HSync ends at pixel 590 of 638: 48 px to the picture
+	t.de_v = 262 - 248;                             // VSync ends at line 248 of 262
+	t.active_ns = 529 * 100.0; t.width = 529; t.height = 240;
+	int e[4];
+	CHECK(guncal_core_edges(&f, &t, e));
+	CHECK(abs(e[2] - rawx_of(0)) <= 1 && abs(e[3] - rawx_of(528)) <= 1);
+	CHECK(abs(e[0] - rawy_of(0)) <= 1 && abs(e[1] - rawy_of(239)) <= 1);
+}
+
+// the NB-1 core (Point Blank): 384 px at 6.048 MHz, picture 288 x 224, HSync 32 px starting 74 px before the picture,
+// VSync 3 lines starting 33 lines before it
+static void test_edges_for_the_nb1_core()
+{
+	guncal_fit f = make_fit();
+	double px = 1e9 / 6.048e6;                      // 165.3 ns
+	guncal_core_timing t;
+	t.hs_ns = 32 * px; t.vs_lines = 3;
+	t.de_h_ns = (74 - 32) * px;
+	t.de_v = 33 - 3;
+	t.active_ns = 288 * px; t.width = 288; t.height = 224;
+	int e[4];
+	CHECK(guncal_core_edges(&f, &t, e));
+	// picture left edge = 74 px * 165.3 ns = 12.23 us after HSync starts = GunCal pixel 28.3; right edge at 502.8
+	CHECK(abs(e[2] - rawx_of(28.3)) <= 1);
+	CHECK(abs(e[3] - rawx_of(502.8)) <= 1);
+	CHECK(abs(e[0] - rawy_of(16)) <= 1);            // 33 lines after VSync start vs GunCal's 17
+	CHECK(abs(e[1] - rawy_of(16 + 223)) <= 1);
+	CHECK(e[2] < e[3] && e[0] < e[1]);
+}
+
+static void test_edges_reject_nonsense()
+{
+	guncal_fit f = make_fit();
+	guncal_core_timing t;
+	memset(&t, 0, sizeof(t));
+	int e[4];
+	CHECK(!guncal_core_edges(&f, &t, e));
+	f.valid = 0;
+	t.width = 256; t.height = 240; t.active_ns = 47000; t.de_h_ns = 5000; t.hs_ns = 4700; t.vs_lines = 3; t.de_v = 14;
+	CHECK(!guncal_core_edges(&f, &t, e));
+}
+
+int main()
+{
+	test_fit_recovers_the_line();
+	test_fit_rejects_bad_shots();
+	test_five_points_beat_three_under_aim_noise();
+	test_file_roundtrip();
+	test_full_sequence();
+	test_missed_shot_repeats_the_point();
+	test_hold_trigger_restarts();
+	test_margin_change_midway_still_fits();
+	test_noise_samples_use_median();
+	test_edges_for_the_calibration_core_itself();
+	test_edges_for_the_nb1_core();
+	test_edges_reject_nonsense();
+	if (failures) { printf("%d check(s) failed\n", failures); return 1; }
+	printf("all guncal tests passed\n");
+	return 0;
+}
