+// Send one raw 32-bit word to the core as joystick_<idx> (2..5), both halves, always. Used to drive the GunCal core.
+void user_io_joystick_word(int idx, uint32_t v)
+{
+	if (idx < 2 || idx > 5) return;
+	spi_uio_cmd_cont(UIO_JOYSTICK2 + idx - 2);
+	spi_w(v);
+	spi_w(v >> 16);
+	DisableIO();
+}
