+// Host-side tests for guncal:
+//   g++ -std=gnu++14 -Wall -Wextra -I. test/guncal_test.cpp guncal.cpp -o /tmp/gctest && /tmp/gctest
+#include <stdio.h>
+#include <stdlib.h>
+#include <math.h>
+#include <string.h>
+#include "guncal.h"
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { printf("FAIL line %d: %s\n", __LINE__, #cond); failures++; } } while (0)
+
+// a pretend display: raw = a * px + b (what the real gun should do)
+static const double AX = 1.19, BX = 112.0, AY = 0.97, BY = 18.0;
+static int rawx_of(double px) { return (int)floor(AX * px + BX + 0.5); }
+static int rawy_of(double py) { return (int)floor(AY * py + BY + 0.5); }
+
+static void test_fit_recovers_the_line()
+{
+	guncal_target t[GUNCAL_NPOINTS];
+	int raw[GUNCAL_NPOINTS][2];
+	for (int i = 0; i < GUNCAL_NPOINTS; i++) { t[i] = guncal_target_xy(i, 12); raw[i][0] = rawx_of(t[i].x); raw[i][1] = rawy_of(t[i].y); }
+	guncal_fit f;
+	CHECK(guncal_fit_points(raw, t, GUNCAL_NPOINTS, &f));
+	CHECK(fabs(f.ax - AX) < 0.01 && fabs(f.bx - BX) < 2.0);
+	CHECK(fabs(f.ay - AY) < 0.01 && fabs(f.by - BY) < 2.0);
+	// the corners and edges of the picture, including parts a TV would hide, come out right by extrapolation
+	int px, py;
+	guncal_raw_to_px(&f, rawx_of(0), rawy_of(0), &px, &py);
+	CHECK(abs(px - 0) <= 2 && abs(py - 0) <= 2);
+	guncal_raw_to_px(&f, rawx_of(528), rawy_of(239), &px, &py);
+	CHECK(abs(px - 528) <= 2 && abs(py - 239) <= 2);
+}
+
+static void test_fit_rejects_bad_shots()
+{
+	guncal_target t[GUNCAL_NPOINTS];
+	int good[GUNCAL_NPOINTS][2];
+	for (int i = 0; i < GUNCAL_NPOINTS; i++) { t[i] = guncal_target_xy(i, 12); good[i][0] = rawx_of(t[i].x); good[i][1] = rawy_of(t[i].y); }
+	guncal_fit f;
+	int swapped[GUNCAL_NPOINTS][2];
+	for (int i = 0; i < GUNCAL_NPOINTS; i++) { swapped[i][0] = good[i][0]; swapped[i][1] = good[i][1]; }
+	swapped[1][0] = good[2][0]; swapped[2][0] = good[1][0];     // two shots in the wrong order
+	CHECK(!guncal_fit_points(swapped, t, GUNCAL_NPOINTS, &f));
+	int noise[GUNCAL_NPOINTS][2] = { { 300, 50 }, { 700, 60 }, { 100, 200 }, { 400, 20 }, { 250, 250 } };  // a gun with no sync
+	CHECK(!guncal_fit_points(noise, t, GUNCAL_NPOINTS, &f));
+	int same[GUNCAL_NPOINTS][2] = { { 400, 100 }, { 400, 100 }, { 400, 100 }, { 400, 100 }, { 400, 100 } };
+	CHECK(!guncal_fit_points(same, t, GUNCAL_NPOINTS, &f));
+	int oneoff[GUNCAL_NPOINTS][2];
+	for (int i = 0; i < GUNCAL_NPOINTS; i++) { oneoff[i][0] = good[i][0]; oneoff[i][1] = good[i][1]; }
+	oneoff[3][1] += 40;                                           // one wild shot among five
+	CHECK(!guncal_fit_points(oneoff, t, GUNCAL_NPOINTS, &f));
+}
+
+// hand-aimed shots are off by a couple of lines; five spread targets must beat two vertical levels
+static void test_five_points_beat_three_under_aim_noise()
+{
+	srand(7);
+	double e5 = 0, e3 = 0;
+	int trials = 400;
+	guncal_target t[GUNCAL_NPOINTS];
+	for (int i = 0; i < GUNCAL_NPOINTS; i++) t[i] = guncal_target_xy(i, 12);
+	for (int k = 0; k < trials; k++)
+	{
+		int raw[GUNCAL_NPOINTS][2];
+		for (int i = 0; i < GUNCAL_NPOINTS; i++)
+		{
+			double nx = ((rand() % 7) - 3) * 1.0, ny = ((rand() % 7) - 3) * 1.0;     // +-3 units of aiming noise
+			raw[i][0] = rawx_of(t[i].x) + (int)nx;
+			raw[i][1] = rawy_of(t[i].y) + (int)ny;
+		}
+		guncal_fit f5, f3;
+		if (guncal_fit_points(raw, t, GUNCAL_NPOINTS, &f5)) e5 += (f5.ay - AY) * (f5.ay - AY); else e5 += 1;
+		// the old three-target layout: top-left, top-right, near the bottom
+		guncal_target t3[3] = { t[1], t[2], { 300, 207 } };
+		int raw3[3][2] = { { raw[1][0], raw[1][1] }, { raw[2][0], raw[2][1] }, { rawx_of(300) + (int)((rand() % 7) - 3), rawy_of(207) + (int)((rand() % 7) - 3) } };
+		if (guncal_fit_points(raw3, t3, 3, &f3)) e3 += (f3.ay - AY) * (f3.ay - AY); else e3 += 1;
+	}
+	double rms5 = sqrt(e5 / trials), rms3 = sqrt(e3 / trials);
+	printf("  vertical slope error under +-3 aiming noise: 5 points rms %.4f, 3 points rms %.4f\n", rms5, rms3);
+	CHECK(rms5 < 0.02);
+	CHECK(rms5 < rms3);
+}
