+int guncal_button_at(int px, int py)
+{
+	if (py < GUNCAL_BTN_Y0 || py > GUNCAL_BTN_Y1) return GUNCAL_BTN_NONE;
+	if (px >= GUNCAL_BTN_RETRY_X0 && px <= GUNCAL_BTN_RETRY_X1) return GUNCAL_BTN_RETRY;
+	if (px >= GUNCAL_BTN_EXIT_X0 && px <= GUNCAL_BTN_EXIT_X1) return GUNCAL_BTN_EXIT;
+	return GUNCAL_BTN_NONE;
+}
