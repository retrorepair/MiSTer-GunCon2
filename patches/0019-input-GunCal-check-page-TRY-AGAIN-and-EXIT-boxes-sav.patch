diff --git a/test/guncal_test.cpp b/test/guncal_test.cpp
index 4f449e3..4640065 100644
--- a/test/guncal_test.cpp
+++ b/test/guncal_test.cpp
@@ -107,6 +107,18 @@ static void shoot(guncal_sm *s, uint32_t *t, int with_light)
 	guncal_tick(s, *t);
 }
 
+// the same for a shot at a given core pixel (the check page's buttons)
+static void shoot_at(guncal_sm *s, uint32_t *t, int px, int py, int with_light)
+{
+	int x = with_light ? rawx_of(px) : 0, y = with_light ? rawy_of(py) : 5;
+	guncal_report(s, x, y, 0, *t); *t += 20;
+	guncal_report(s, x, y, 1, *t); *t += 20;
+	for (int i = 0; i < 6; i++) { guncal_report(s, x + (i & 1), y, 1, *t); *t += 20; }
+	guncal_report(s, x, y, 0, *t); *t += 20;
+	*t += 400;
+	guncal_tick(s, *t);
+}
+
