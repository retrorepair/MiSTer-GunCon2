 {
@@ -120,7 +134,8 @@ struct guncal_sm
 	int      msg;
 	uint32_t first_valid_dt;                     // ms from the pull to the first valid report (0 = none yet)
 	guncal_fit fit;
-	int      saved;                              // a new fit is ready for the caller to store
+	int      saved;                              // the fit is accepted: the caller stores it (and logs it)
+	int      exit_req;                           // EXIT (or A): the caller leaves the core once it has stored the fit
 	int      shot_done;                          // a shot just finished: shot_point/shot_n/shot_ok describe it (caller clears)
 	int      shot_point, shot_n, shot_ok;
 };
@@ -129,10 +144,10 @@ void guncal_init(guncal_sm *s, const guncal_fit *stored, int margin_pct);   // s
 void guncal_nudge(guncal_sm *s, int delta_pct);                                // move the targets in or out (gun D-pad)
 void guncal_report(guncal_sm *s, int x, int y, int trig, uint32_t now_ms);   // one raw gun report
 void guncal_tick(guncal_sm *s, uint32_t now_ms);                              // call regularly
-void guncal_accept(guncal_sm *s);                                              // A or B on the check page: finish
+void guncal_accept(guncal_sm *s, int to_monitor);                             // A (to_monitor 0: save and exit) or B (1: save and show the monitor page) on the check page
 uint32_t guncal_cmd_word(const guncal_sm *s);
 
-// Words sent to the core:
+// Words sent to the core (the check page's pointer is shown on the monitor page and while a check shot is measured too):
 //   joystick_4 (guncal_cmd_word): [1:0] page  [5:2] target  [7:6] flash sequence  [9:8] message  [10] pointer valid
