 //     raw_x = ax * px + bx        raw_y = ay * py + by
 // Five targets (centre and the four corners) give a long baseline both ways, so the aiming noise of a hand-held
-// gun averages out. After the fit the core shows a check page with a live crosshair; A or B ends it.
+// gun averages out. After the fit the core shows a check page: the target crosshair, a live crosshair for the gun, and two boxes, TRY AGAIN and EXIT. A shot at a
+// box is measured exactly like a calibration shot (the screen flashes white, the first valid reports are the aim), never taken from where the
+// gun pointed before the flash. EXIT saves the calibration and leaves the core; TRY AGAIN starts over. Nothing is saved before EXIT.
 // This module holds that maths and the sequencing. It has no MiSTer dependencies so it can be tested on the host.
 
 #define GUNCAL_NPOINTS      5
@@ -97,9 +99,21 @@ int guncal_core_edges(const guncal_fit *f, const guncal_core_timing *t, int out[
 // The range an on-screen aim is kept within: e shrunk by pct percent of its span at each end. Same order as e: { y_top, y_bottom, x_left, x_right }.
 void guncal_inset_range(const int e[4], double pct, int out[4]);
 
+// ---- the check page's buttons ----
+//
+// In core pixels. The core draws them (cores/GunCal/rtl/guncal.v: in_btn_*; keep the numbers in step).
+#define GUNCAL_BTN_Y0        168
+#define GUNCAL_BTN_Y1        191
+#define GUNCAL_BTN_RETRY_X0  108
+#define GUNCAL_BTN_RETRY_X1  240
+#define GUNCAL_BTN_EXIT_X0   288
+#define GUNCAL_BTN_EXIT_X1   420
+enum { GUNCAL_BTN_NONE = 0, GUNCAL_BTN_RETRY = 1, GUNCAL_BTN_EXIT = 2 };
+int guncal_button_at(int px, int py);
+
 // ---- the sequence ----
 
-enum { GCS_MONITOR = 0, GCS_AIM, GCS_COLLECT, GCS_VERIFY };
+enum { GCS_MONITOR = 0, GCS_AIM, GCS_COLLECT, GCS_VERIFY, GCS_VCOLLECT };   // VCOLLECT: a shot on the check page is being measured
 
