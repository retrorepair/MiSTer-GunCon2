 guncal.h             | 25 +++++++++++++++----
 input.cpp            | 11 ++++++++-
 test/guncal_test.cpp | 50 ++++++++++++++++++++++++++++++++-----
 4 files changed, 120 insertions(+), 25 deletions(-)

