-	guncal_accept(&s);                                 // A or B
-	CHECK(s.state == GCS_MONITOR && (guncal_cmd_word(&s) & 3) == GUNCAL_PAGE_MONITOR);
+	// the check page's buttons: a pull makes the screen flash and the shot is what the gun saw in it, tested against the boxes
+	CHECK(guncal_button_at(150, 184) == GUNCAL_BTN_RETRY && guncal_button_at(375, 184) == GUNCAL_BTN_EXIT);
+	CHECK(guncal_button_at(264, 120) == GUNCAL_BTN_NONE && guncal_button_at(264, 184) == GUNCAL_BTN_NONE);
+	{
+		guncal_sm f = s;
+		uint32_t t2 = t;
+		int seq0 = f.flash_seq;
+		guncal_report(&f, rawx_of(375), rawy_of(184), 0, t2);
+		guncal_report(&f, rawx_of(375), rawy_of(184), 1, t2 + 20);
+		CHECK(f.state == GCS_VCOLLECT && f.flash_seq != seq0 && (guncal_cmd_word(&f) & 3) == GUNCAL_PAGE_VERIFY);
+		guncal_tick(&f, t2 + 100);
+		CHECK(f.state == GCS_VCOLLECT && !f.saved && !f.exit_req);              // not decided before the flash is over
+
+		guncal_sm r = s, e = s, n = s, d = s;
+		shoot_at(&r, &t2, 150, 184, 1);
+		CHECK(r.state == GCS_AIM && r.point == 0 && !r.saved && !r.exit_req);   // TRY AGAIN
+		shoot_at(&e, &t2, 375, 184, 1);
+		CHECK(e.saved && e.exit_req);                                           // EXIT: kept, and the caller leaves
+		shoot_at(&n, &t2, 264, 120, 1);
+		CHECK(n.state == GCS_VERIFY && !n.saved && !n.exit_req);                // the ring is not a button
+		shoot_at(&d, &t2, 375, 184, 0);
+		CHECK(d.state == GCS_VERIFY && !d.saved && !d.exit_req);                // no light in the flash: no shot
+	}
+	guncal_sm a = s, b = s;
+	guncal_accept(&a, 0);                              // A
+	CHECK(a.saved && a.exit_req);
+	guncal_accept(&b, 1);                              // B
+	CHECK(b.saved && !b.exit_req && b.state == GCS_MONITOR && (guncal_cmd_word(&b) & 3) == GUNCAL_PAGE_MONITOR);
 }
 
