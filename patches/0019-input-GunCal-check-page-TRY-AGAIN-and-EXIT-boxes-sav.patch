+	if (s->state == GCS_VERIFY || s->state == GCS_VCOLLECT) t = guncal_target_xy(0, s->margin_pct);
 	return (uint32_t)t.x | ((uint32_t)t.y << 10) | ((uint32_t)GUNCAL_NPOINTS << 18);
 }
 
diff --git a/guncal.h b/guncal.h
index 748d43b..30b082a 100644
--- a/guncal.h
+++ b/guncal.h
@@ -11,7 +11,9 @@
