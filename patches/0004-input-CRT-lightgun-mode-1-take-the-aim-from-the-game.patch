+
+// Mode 1 (aim from the game's flash): the core is given the held aim, not the gun's raw axes. Send it whenever it changes.
+static int32_t crtgun_sent[NUMDEV][2];
+static bool    crtgun_sent_ok[NUMDEV];
+
+static void crtgun_deliver(int i, const crtgun_params *p)
+{
+	if (p->mode != 1) return;
+
+	int32_t px = crtgun[i].pub_off ? p->xmin - 1 : crtgun[i].pub_x;    // one unit outside the range clamps to the edge = offscreen
+	int32_t py = crtgun[i].pub_off ? p->ymin - 1 : crtgun[i].pub_y;
+
+	struct input_absinfo ai;
+	struct input_event e;
+	memset(&ai, 0, sizeof(ai));
+	memset(&e, 0, sizeof(e));
+	e.type = EV_ABS;
+
+	if (!crtgun_sent_ok[i] || px != crtgun_sent[i][0])
+	{
+		ai.minimum = p->xmin; ai.maximum = p->xmax;
+		e.code = ABS_X; e.value = px;
+		input_cb(&e, &ai, i);
+		crtgun_sent[i][0] = px;
+	}
+	if (!crtgun_sent_ok[i] || py != crtgun_sent[i][1])
+	{
+		ai.minimum = p->ymin; ai.maximum = p->ymax;
+		e.code = ABS_Y; e.value = py;
+		input_cb(&e, &ai, i);
+		crtgun_sent[i][1] = py;
+	}
+	crtgun_sent_ok[i] = true;
 }
 
