+		crtgun_update(&crtgun[i], &p, now);
 	}
 	else if (ev->type == EV_KEY && ev->code == GUNCON2_TRIGGER_CODE)
 	{
 		crtgun_set_trigger(&crtgun[i], ev->value != 0, now, &p);
+		crtgun_update(&crtgun[i], &p, now);
+	}
+	else if (ev->type == EV_SYN)
+	{
+		crtgun_report(&crtgun[i], &p, now);             // a complete gun report
 	}
 	else
 	{
 		return;
 	}
 
