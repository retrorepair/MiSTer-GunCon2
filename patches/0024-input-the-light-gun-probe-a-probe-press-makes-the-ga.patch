+// Cores whose game flashes for one field after the trigger and reads the gun at the end of it, before the GunCon 2 can report that field
+// (lightgun_crt.h, "Probe"): each shot is preceded by a probe press that makes the game flash. By the core's own name. LIGHTGUN_CRT_PROBE=0 turns it off.
+static const char *crtgun_probe_cores[] = {
+	"Model2A",      // House of the Dead (the Model2C core reports this name), measured 2026-10-23: flash report 33..35 ms after the pull, read before it
+};
+
+static bool crtgun_probe_core(void)
+{
+	if (!cfg.lightgun_crt_probe) return false;
+	const char *c = user_io_get_core_name(1);
+	for (size_t n = 0; n < sizeof(crtgun_probe_cores) / sizeof(*crtgun_probe_cores); n++) if (!strcasecmp(c, crtgun_probe_cores[n])) return true;
+	return false;
+}
+
 static void crtgun_get_params(int i, crtgun_params *p)
 {
 	guncal_apply_universal(i);
@@ -2325,6 +2339,7 @@ static void crtgun_get_params(int i, crtgun_params *p)
 	p->mode = cfg.lightgun_crt_mode;
 	p->beacon = crtgun_beacon_core() ? 1 : 0;
 	if (p->beacon) p->mode = 0;       // the beacon measures every shot itself; between shots the aim just follows the gun
+	p->probe = !p->beacon && crtgun_probe_core() ? 1 : 0;
 }
 
 // Mode 1 (aim from the game's flash): the core is given the held aim, not the gun's raw axes. Send it whenever it changes.
@@ -2396,16 +2411,22 @@ static void crtgun_beacon_apply(int i, const crtgun_params *p)
 		user_io_joystick_word(3, req ? 1u : 0u);
 		crtgun_bc_req_sent[i] = req;
 	}
+	if (p->probe)
+	{
+		// a release always before a press: the probe's press and release can both be due in one poll
+		if (crtgun[i].pb_ev_release) { crtgun[i].pb_ev_release = false; crtgun_give_trigger(i, false); }
+		if (crtgun[i].pb_ev_press)   { crtgun[i].pb_ev_press = false;   crtgun_give_trigger(i, true); }
+	}
 	if (!p->beacon) return;
 	if (crtgun[i].bc_ev_release) { crtgun[i].bc_ev_release = false; crtgun_give_trigger(i, false); }
 	if (crtgun[i].bc_ev_press)   { crtgun[i].bc_ev_press = false;   crtgun_give_trigger(i, true); }
 }
 
-// True if this event is the trigger of a gun whose trigger the beacon holds back (the tracker has already been given it).
+// True if this event is the trigger of a gun whose trigger the beacon or the probe holds back (the tracker has already been given it).
 static bool crtgun_beacon_holds(int i, const struct input_event *ev)
 {
 	if (!cfg.lightgun_crt_tracker || ev->type != EV_KEY || ev->code != GUNCON2_TRIGGER_CODE) return false;
-	if (mapping || user_io_osd_is_visible() || !crtgun_beacon_core()) return false;
+	if (mapping || user_io_osd_is_visible() || !(crtgun_beacon_core() || crtgun_probe_core())) return false;
 	return input[i].quirk == QUIRK_LIGHTGUN_CRT;
 }
 
@@ -2418,12 +2439,12 @@ static void crtgun_tick(void)
 	static uint32_t next = 0;
 	if (!cfg.lightgun_crt_tracker) return;
 	if (next && !CheckTimer(next)) return;
-	next = GetTimer(8);
 
 	struct timespec ts;
 	clock_gettime(CLOCK_REALTIME, &ts);
 	uint32_t now = (uint32_t)ts.tv_sec * 1000u + (uint32_t)(ts.tv_nsec / 1000000);
 
+	bool busy = false;
 	for (int i = 0; i < NUMDEV; i++)
 	{
 		if (input[i].quirk != QUIRK_LIGHTGUN_CRT || !crtgun_sent_ok[i]) continue;    // a gun that has reported at least once
@@ -2431,9 +2452,18 @@ static void crtgun_tick(void)
 		crtgun_get_params(i, &p);
 		crtgun_update(&crtgun[i], &p, now);
 		crtgun_beacon_poll(&crtgun[i], &p, now);
+		crtgun_probe_poll(&crtgun[i], &p, now);
 		crtgun_deliver(i, &p);
