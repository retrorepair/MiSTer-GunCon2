+static void test_probe_quick_second_pull_releases_and_waits()
+{
+	Rig r(&PP);
+	r.pb_trigger(1000, true);
+	r.poll(1003); r.take_press();
+	r.report(1037, 420, 135);
+	r.poll(1043); r.take_release();
+	r.poll(1078);
+	CHECK(r.take_press() && r.s.pb_phase == 4);
+	r.pb_trigger(1100, false);
+	r.pb_trigger(1105, true);                                                // a new pull while the real press is still down at the core
+	CHECK(r.take_release() && r.s.pb_phase == 1 && r.s.pub_off);
+	r.poll(1139);
+	CHECK(!r.take_press());                                                  // the game must see the trigger up for 35 ms first
+	r.poll(1140);
+	CHECK(r.take_press() && r.s.pb_phase == 2);
+}
