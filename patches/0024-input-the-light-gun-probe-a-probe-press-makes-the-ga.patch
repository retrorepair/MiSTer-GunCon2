+// ---- probe: a probe press makes the game flash, the real press follows with the aim from that flash
+
+// the House of the Dead trace: dark scene, the flash is one lit report 34 ms after the press
+static void test_probe_dark_scene_shot()
+{
+	Rig r(&PP);
+	for (int i = 0; i < 10; i++) r.report(800 + i * 17, i & 1, 5);
+	r.pb_trigger(1000, true);
+	CHECK(r.s.pub_off && r.s.pb_phase == 1 && !r.take_press());             // the aim is off the screen, the physical trigger held back
+	r.poll(1002);
+	CHECK(!r.take_press());
+	r.poll(1003);
+	CHECK(r.take_press() && r.s.pb_phase == 2);                             // the probe press
+	r.report(1020, 1, 5);
+	r.report(1037, 420, 135);                                                // the flash it caused
+	CHECK(r.s.pb_seen && r.s.pub_off);                                       // seen, but off the screen while the probe press is down
+	r.poll(1043);
+	CHECK(r.take_release() && r.s.pb_phase == 3 && r.s.pub_off);            // the probe press goes up after 40 ms
+	r.poll(1046);
+	CHECK(!r.s.pub_off && r.s.pub_x == 420 && r.s.pub_y == 135 && !r.take_press());   // the aim is in place before the real press
+	r.pb_trigger(1050, false);                                               // the player lets go: nothing reaches the core
+	CHECK(!r.take_release() && !r.take_press());
+	r.poll(1077);
+	CHECK(!r.take_press());
+	r.poll(1078);
+	CHECK(r.take_press() && r.s.pb_phase == 4 && r.s.pub_x == 420);         // the trigger has been up 35 ms: the real press
+	r.poll(1117);
+	CHECK(!r.take_release());
+	r.poll(1118);
+	CHECK(r.take_release());                                                 // a real press lasts 40 ms
+	r.report(1200, 500, 200);                                                // the scene afterwards does not move the shot
+	CHECK(r.s.pub_x == 420 && r.s.pub_y == 135 && !r.s.pub_off);
+}
+
+static void test_probe_no_light_is_the_reload()
+{
+	Rig r(&PP);
+	r.report(900, 420, 135);
+	r.report(950, 0, 5);                                                     // swung off the screen
+	r.pb_trigger(1000, true);
+	r.poll(1003);
+	CHECK(r.take_press());
+	r.report(1020, 1, 5);
+	r.report(1037, 0, 5);                                                    // no flash where the gun points
+	r.poll(1043);
+	CHECK(r.take_release());
+	r.report(1054, 1, 5);
+	r.report(1071, 0, 5);
+	r.report(1088, 1, 5);
+	r.poll(1102);
+	CHECK(r.s.pb_phase == 3 && !r.take_press());
+	r.poll(1103);
+	CHECK(r.s.pb_phase == 0 && !r.take_press() && r.s.pub_off);             // no light: the probe press was the reload, nothing else is sent
+	r.report(1200, 430, 140);
+	CHECK(r.s.pub_off);
+}
