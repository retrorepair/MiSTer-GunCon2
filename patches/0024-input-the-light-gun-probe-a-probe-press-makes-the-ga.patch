diff --git a/lightgun_crt.cpp b/lightgun_crt.cpp
index 66f92fe..7d6c82b 100644
--- a/lightgun_crt.cpp
+++ b/lightgun_crt.cpp
@@ -44,7 +44,7 @@ static void publish(crtgun_state *s, const crtgun_params *p, uint32_t now_ms)
 {
 	if (p->beacon && s->bc_phase != 0) return;      // a beacon measurement (or its hold) owns the aim
 
-	if (p->mode != 1)
+	if (p->mode != 1 && !p->probe)
 	{
 		s->pub_x = s->out_x;
 		s->pub_y = s->out_y;
@@ -60,12 +60,14 @@ static void publish(crtgun_state *s, const crtgun_params *p, uint32_t now_ms)
 		s->pub_off = false;
 	}
 
+	if (p->probe) return;                           // the probe sequence owns the aim (crtgun_probe_poll)
+
 	if (s->win_open && (uint32_t)(now_ms - s->win_t0) > p->shot_ms) s->win_open = false;
 }
 
 void crtgun_set_trigger(crtgun_state *s, bool down, uint32_t now_ms, const crtgun_params *p)
 {
-	if (down && !s->trig && p->mode == 1)
+	if (down && !s->trig && p->mode == 1 && !p->probe)
 	{
 		// Nothing is known about this shot until the gun sees the game's flash. Until then the gun has seen no light for it, which is
 		// what a light gun's latch says at the start of every shot: off the screen. Nothing seen before the pull is used. The flash
@@ -241,7 +243,7 @@ void crtgun_report(crtgun_state *s, const crtgun_params *p, uint32_t now_ms)
 	}
 	crtgun_beacon_poll(s, p, now_ms);
 
-	if (p->mode == 1 && s->win_open && crtgun_valid(s, p))
+	if (p->mode == 1 && !p->probe && s->win_open && crtgun_valid(s, p))
 	{
 		// the gun has seen the game's flash: where it saw it is the shot, held until the next pull (later readings are the scene again)
 		s->pub_x = s->raw_x;
@@ -249,4 +251,97 @@ void crtgun_report(crtgun_state *s, const crtgun_params *p, uint32_t now_ms)
 		s->pub_off = false;
 		s->win_open = false;
 	}
+
+	// probe: the first valid reading after the probe press is where the gun saw the flash it caused
+	if (p->probe && (s->pb_phase == 2 || s->pb_phase == 3) && !s->pb_seen && (int32_t)(now_ms - s->pb_probe_t) > 0 && crtgun_valid(s, p))
+	{
+		s->pb_x = s->raw_x;
+		s->pb_y = s->raw_y;
+		s->pb_seen = true;
+	}
+	crtgun_probe_poll(s, p, now_ms);
+}
+
+static void pb_press(crtgun_state *s, uint32_t now_ms)
+{
+	s->pb_pressed = true;
+	s->pb_press_t = now_ms;
+	s->pb_ev_press = true;
+}
+
+static void pb_release(crtgun_state *s, uint32_t now_ms)
+{
+	s->pb_pressed = false;
+	s->pb_rel_t = now_ms;
+	s->pb_rel_seen = true;
+	s->pb_ev_release = true;
+}
+
+void crtgun_probe_trigger(crtgun_state *s, const crtgun_params *p, bool down, uint32_t now_ms)
+{
+	if (!p->probe) return;
+	if (down && !s->pb_trig_in && (s->pb_phase == 0 || s->pb_phase == 4))
+	{
+		// A new shot (a pull while one is being measured is part of it). If the core still has the last real press down it goes up first,
+		// and the probe press waits until the game has seen the trigger up.
+		if (s->pb_pressed) pb_release(s, now_ms);
+		s->pb_phase = 1;
+		s->pb_t0 = now_ms;
+		s->pb_seen = false;
+		s->pub_init = true;
+		s->pub_off = true;                          // nothing seen for this shot yet
+	}
+	s->pb_trig_in = down;
+}
+
+void crtgun_probe_poll(crtgun_state *s, const crtgun_params *p, uint32_t now_ms)
+{
+	if (!p->probe) return;
+	bool up_long = !s->pb_rel_seen || (uint32_t)(now_ms - s->pb_rel_t) >= CRTGUN_PB_GAP_MS;
+
+	switch (s->pb_phase)
+	{
+	case 1:     // the aim is off the screen: the probe press
+		if ((uint32_t)(now_ms - s->pb_t0) >= CRTGUN_PB_LEAD_MS && up_long)
+		{
+			pb_press(s, now_ms);
+			s->pb_probe_t = now_ms;
+			s->pb_phase = 2;
+		}
+		break;
+
+	case 2:     // the game flashes; the probe press goes up when it has lasted long enough
+		if ((uint32_t)(now_ms - s->pb_press_t) >= CRTGUN_PB_PRESS_MS)
+		{
+			pb_release(s, now_ms);
+			s->pb_phase = 3;
+		}
+		break;
+
+	case 3:
+		if (s->pb_seen)
+		{
+			// the aim goes on the screen only once the probe press is up, then the real press follows with it in place
+			if ((uint32_t)(now_ms - s->pb_rel_t) >= CRTGUN_PB_LEAD_MS)
+			{
+				s->pub_x = s->pb_x;
+				s->pub_y = s->pb_y;
+				s->pub_off = false;
+			}
+			if (!s->pub_off && up_long)
+			{
+				pb_press(s, now_ms);
+				s->pb_phase = 4;
+			}
+		}
+		else if ((uint32_t)(now_ms - s->pb_probe_t) >= CRTGUN_PB_GIVEUP_MS)
+		{
+			s->pb_phase = 0;                        // no light: the gun is off the screen, and the probe press was the reload
+		}
+		break;
+
+	case 4:     // the real press stays down while the trigger is held, and at least CRTGUN_PB_PRESS_MS
+		if (s->pb_pressed && !s->pb_trig_in && (uint32_t)(now_ms - s->pb_press_t) >= CRTGUN_PB_PRESS_MS) pb_release(s, now_ms);
+		break;
+	}
 }
diff --git a/lightgun_crt.h b/lightgun_crt.h
index 72668c1..2a118ce 100644
--- a/lightgun_crt.h
+++ b/lightgun_crt.h
@@ -44,6 +44,7 @@ struct crtgun_params
 	int32_t  edge_pct;      // percentage of each axis span, from each edge, that counts as "edge"
 	int32_t  mode;          // 0 continuous, 1 aim from the game's flash (see above)
 	int32_t  beacon;        // 1: the core flashes the whole picture white when asked (see "Beacon" below); 0: it cannot
+	int32_t  probe;         // 1: the game's flash is read before the gun can report it, so a probe press makes it flash first (see "Probe" below)
 };
 
 // Beacon. A CRT gun reads only where there is light: a dark enemy, or a dark patch of the picture, gives it nothing and the aim is lost,
@@ -58,6 +59,19 @@ struct crtgun_params
 #define CRTGUN_BC_HOLD_MS     250   // the measured aim is held this long after the trigger is given (the game reads it a frame or two later)
 #define CRTGUN_BC_MIN_PRESS_MS 40   // the trigger is given to the core for at least this long (its I/O board scans at 1 kHz)
 
+// Probe. Some games flash for one field after the trigger and read the gun at the end of that field (House of the Dead, measured 2026-10-23:
+// the gun's one lit report of the flash reaches the app 33..35 ms after the pull, after the game has read). The GunCon 2 reports a field only
+// after it ends, so the shot cannot be given the aim from its own flash in time. Instead, with only the game's own flash and nothing changed in the
+// core: on a pull the physical trigger is held back and the aim goes off the screen; a probe press is given (the game flashes, and with the gun
+// off the screen it counts a reload); the first valid reading after the probe press is where the gun saw that flash; the probe press is released,
+// the aim is set to that reading, and once the game has seen the trigger up the real press is given with the aim already in place, so the game
+// reads it whenever it looks. No light after the probe press means the gun is off the screen, and the probe press was the reload.
+// Costs: every shot also reloads, two flashes, and the shot reaches the game about 75 ms after the pull.
+#define CRTGUN_PB_LEAD_MS      3    // the aim is off the screen this long before the probe press (the Model 2 I/O board scans at 1 kHz)
+#define CRTGUN_PB_PRESS_MS     40   // each press given to the core lasts at least this long
+#define CRTGUN_PB_GAP_MS       35   // the trigger is up this long before a press, so the game sees it up (two fields)
+#define CRTGUN_PB_GIVEUP_MS    100  // no light this long after the probe press: the gun is off the screen
+
 struct crtgun_state
 {
 	int32_t  raw_x, raw_y;  // latest raw report
@@ -95,6 +109,21 @@ struct crtgun_state
 	bool     bc_rel_pending;// the trigger came up before (or just after) the press: give the release once the press has been long enough
 	bool     bc_ev_press;   // event for the caller: give the core the trigger press now (the caller clears it)
 	bool     bc_ev_release; // event for the caller: give the core the trigger release now (the caller clears it)
+
+	// probe (params.probe)
+	int      pb_phase;      // 0 idle (the aim holds the last shot), 1 aim off the screen, probe press due, 2 probe press given,
+	                        // 3 probe press released, real press due once the flash is seen, 4 real press given
+	uint32_t pb_t0;         // the pull
+	uint32_t pb_probe_t;    // when the probe press was given (only readings after it are the flash)
+	uint32_t pb_press_t;    // when the press now down was given
+	uint32_t pb_rel_t;      // when the core was last given a release
+	bool     pb_rel_seen;   // pb_rel_t is valid
+	bool     pb_seen;       // the flash has been seen at pb_x / pb_y
+	int32_t  pb_x, pb_y;
+	bool     pb_trig_in;    // the physical trigger is down
+	bool     pb_pressed;    // the core has the trigger down
+	bool     pb_ev_press;   // event for the caller: give the core the trigger press now (the caller clears it)
+	bool     pb_ev_release; // event for the caller: give the core the trigger release now (the caller clears it)
 };
 
 #define CRTGUN_DEF_X_VALID_MIN 16
@@ -121,6 +150,11 @@ void crtgun_report(crtgun_state *s, const crtgun_params *p, uint32_t now_ms);
 void crtgun_beacon_trigger(crtgun_state *s, const crtgun_params *p, bool down, uint32_t now_ms);
 void crtgun_beacon_poll(crtgun_state *s, const crtgun_params *p, uint32_t now_ms);
 
+// Probe: the physical trigger changed (call instead of letting the press and release reach the core), and the poll that runs the sequence
+// (call after every event and every few ms). The caller gives the core the trigger press / release on pb_ev_press / pb_ev_release.
+void crtgun_probe_trigger(crtgun_state *s, const crtgun_params *p, bool down, uint32_t now_ms);
+void crtgun_probe_poll(crtgun_state *s, const crtgun_params *p, uint32_t now_ms);
+
 // True if the gun reports light at all (raw X at or above the "no light" level).
 static inline bool crtgun_lit(const crtgun_state *s, const crtgun_params *p)
 {
